# Copy this file to .env and fill in the key. .env is gitignored; never commit it.

# Required for `python -m app` and `python -m app ask`. Not needed for `build` or `python -m evals`.
ANTHROPIC_API_KEY=

# Model used to translate questions into SQL. Confirm the current ID in the Anthropic docs.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Paths
RAW_CSV_PATH=data/cloudnova_invoices.csv
DB_PATH=build/cloudnova.duckdb

# Date used to flag future-dated invoices (YYYY-MM-DD). Leave blank for today.
AS_OF_DATE=
